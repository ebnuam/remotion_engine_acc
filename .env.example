# ================================================================
# Kok Iso Yo? — AI Gateway & 2-Route Router Configuration Example
# Copy to a secure env file (e.g. ~/.config/kokisoyo/agybridge_render.env, chmod 600)
# NEVER commit real API keys or secrets into Git.
# ================================================================

# Optional path to an external chmod-600 env file (does not overwrite existing shell env vars)
# AI_GATEWAY_ENV_FILE=~/.config/kokisoyo/agybridge_render.env
# AGYBRIDGE_ENV_FILE=~/.config/kokisoyo/agybridge_render.env

# ----------------------------------------------------------------
# 1. 2-Route Router Policy (createAIRouter)
# ----------------------------------------------------------------
# Default route when task is unspecified: standard | premium
AI_ROUTE_DEFAULT=standard

# Route STANDARD model (AGYBridge Render — verified dynamically against GET /v1/models)
AI_STANDARD_MODEL=gemini-2.5-flash

# Route PREMIUM model (Local `agy` CLI on VPS — swap anytime via env, e.g.:
# gemini-4-neon-xhigh, gemini-4-neon-high, claude-opus-5-5-high, gemini-4-hydrogen-xhigh)
AI_PREMIUM_MODEL=gemini-4-neon-high
# Optional reasoning effort for PREMIUM route: low | medium | high | xhigh | max
# AI_PREMIUM_EFFORT=high

# Safe fallback on transient/timeout errors ONLY (false = strict tier separation)
AI_ROUTER_FALLBACK_ON_TRANSIENT=false

# Task-to-route mapping (comma-separated task names)
AI_ROUTE_PREMIUM_TASKS=script_master,creative_director,storyboard_3d,qa_editorial,hook_rewrite,scene_codegen
AI_ROUTE_STANDARD_TASKS=metadata,captions,hashtags,translation,summary,post_copy,draft_outline,seo_pack

# Logging level: debug | info | warn | error | silent
AI_ROUTER_LOG_LEVEL=info

# ----------------------------------------------------------------
# 2. Jalur STANDARD — AGYBridge Render (OpenAI-compatible HTTPS API)
# ----------------------------------------------------------------
# Legacy single-provider selector (for dashboard/server.mjs): antigravity_cli | agybridge | router
AI_GATEWAY_PROVIDER=antigravity_cli

# AGYBridge Render public HTTPS endpoint (without trailing /v1)
AGYBRIDGE_RENDER_URL=https://agybridge.onrender.com

# AGYBridge Render API password / Bearer key (fill locally, NEVER commit)
AGYBRIDGE_RENDER_API_KEY=

# Fallback default model if AI_STANDARD_MODEL is unset
AGYBRIDGE_DEFAULT_MODEL=gemini-2.5-flash

# Network resilience & caching
AGYBRIDGE_TIMEOUT_MS=90000
AGYBRIDGE_MAX_RETRIES=2
AGYBRIDGE_RETRY_BASE_MS=1500
AGYBRIDGE_MODELS_CACHE_TTL_MS=300000
AGYBRIDGE_VERIFY_MODEL_AVAILABLE=true
AGYBRIDGE_LOG_LEVEL=info

# ----------------------------------------------------------------
# 3. Jalur PREMIUM — Antigravity CLI (`agy`) on VPS
# ----------------------------------------------------------------
AGY_CLI_BIN=agy
# AGY_CLI_DEFAULT_MODEL=gemini-4-neon-high
AI_PREMIUM_TIMEOUT_MS=180000
AI_PREMIUM_MAX_RETRIES=1
AI_PREMIUM_RETRY_BASE_MS=2000
AGY_CLI_MODELS_CACHE_TTL_MS=300000
AGY_CLI_VERIFY_MODEL_AVAILABLE=true
AGY_CLI_DISABLE_SLASH_COMMANDS=true
# AGY_CLI_CWD=/tmp

# ----------------------------------------------------------------
# 4. Social Publishing Pipeline (YouTube Shorts, Facebook Reels, Instagram Reels)
# Fill locally in chmod-600 env file when ready for live auto-posting.
# ----------------------------------------------------------------
# YouTube Data API v3 (OAuth2 Refresh Token)
# YT_CLIENT_ID=
# YT_CLIENT_SECRET=
# YT_REFRESH_TOKEN=
# YT_DEFAULT_PRIVACY=private

# Meta Graph API (Facebook Reels + Instagram Reels)
# META_GRAPH_VERSION=v21.0
# META_FB_PAGE_ID=
# META_FB_PAGE_ACCESS_TOKEN=
# META_FB_VIDEO_STATE=PUBLISHED
# META_IG_USER_ID=
# META_IG_ACCESS_TOKEN=

# ----------------------------------------------------------------
# 5. Multi-Provider TTS Gateway (2-Mode: draft vs final)
# ----------------------------------------------------------------
# Default mode: draft (free edge_tts) | final (requires paid commercial tier)
TTS_DEFAULT_MODE=draft
TTS_DRAFT_PROVIDER=edge_tts
# Swap final commercial provider anytime: azure_speech | elevenlabs
TTS_FINAL_PROVIDER=azure_speech
TTS_DEFAULT_LANGUAGE=id-ID
TTS_DEFAULT_FORMAT=mp3
TTS_CACHE_ENABLED=true
# TTS_CACHE_DIR=/tmp/kokisoyo-tts-cache
TTS_TARGET_MIN_SEC=50
TTS_TARGET_MAX_SEC=65
TTS_ENFORCE_DURATION_WINDOW=false

# Draft Provider — Edge TTS (local CLI, $0, non-commercial draft only)
# EDGE_TTS_BIN=~/.local/bin/edge-tts
EDGE_TTS_VOICE=id-ID-ArdiNeural

# Final Provider Option A — Azure AI Speech (Standard Neural S0, ~$15 / 1M chars)
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=southeastasia
# AZURE_SPEECH_VOICE=id-ID-ArdiNeural
# Set to S0 / paid_commercial ONLY on a paid commercial Azure Speech account (F0/free is blocked in final mode)
# AZURE_SPEECH_PLAN_TIER=S0

# Final Provider Option B — ElevenLabs (REST /with-timestamps -> words.json)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Set to starter | creator | pro | scale | paid_commercial ONLY on a paid commercial account
# ELEVENLABS_PLAN_TIER=creator
